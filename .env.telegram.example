# Install on REMOTE SERVER, not your Windows laptop. No frontend/Mini App.
ENVIRONMENT=production
BOT_ONLY=true
BOT_TOKEN=
OWNER_TELEGRAM_ID=0
# Fernet secret for provider OAuth encryption. Keep outside repository.
ENCRYPTION_KEY=
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/pulse?sslmode=require
# Upstash optional in Telegram-only mode (dialog states live in PostgreSQL).
REDIS_URL=
YOUTUBE_API_KEY=
SOURCE_SCAN_INTERVAL_SECONDS=900
WORKER_POLL_SECONDS=10
# OAuth/video delivery require optional public HTTPS callback service.
PUBLIC_BASE_URL=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=awoij3puxl7h1z5u
TIKTOK_CLIENT_SECRET=HQJ5ApmnktaAfOgbN0OMKvPejCiQpEIL
TIKTOK_VERIFIED_MEDIA_DOMAIN=false
# Optional direct URL for Alembic and pg_dump; keep DATABASE_URL for runtime.
DATABASE_URL_UNPOOLED=
# Comma-separated old Fernet keys during encryption-key rotation.
ENCRYPTION_PREVIOUS_KEYS=
MAX_STORAGE_BYTES=2000000000
MEDIA_RETENTION_HOURS=48
